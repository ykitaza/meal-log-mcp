<mxfile host="drawio">
  <diagram id="architecture" name="構成図">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 外側：使う人とクライアント -->
        <mxCell id="user" value="利用者（ブラウザ）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="client" value="Claude / ChatGPT&lt;br&gt;（MCP クライアント）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="480" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- AWS -->
        <mxCell id="cloud" value="AWS" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="980" height="660" as="geometry" />
        </mxCell>
        <mxCell id="region" value="東京リージョン（ap-northeast-1）" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="60" width="940" height="600" as="geometry" />
        </mxCell>

        <!-- 認可API の列 -->
        <mxCell id="cognito" value="Cognito&lt;br&gt;ユーザープール（ログイン画面）&lt;br&gt;新規登録は不可" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;fillColor=#DD344C;" vertex="1" parent="1">
          <mxGeometry x="890" y="110" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="authzApi" value="API Gateway（HTTP API）&lt;br&gt;認可API の入口&lt;br&gt;流量の制限：1秒1回・瞬間5回" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;fillColor=#E7157B;" vertex="1" parent="1">
          <mxGeometry x="410" y="250" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="authzFn" value="Lambda&lt;br&gt;認可API（FastAPI）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;" vertex="1" parent="1">
          <mxGeometry x="650" y="250" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="stateTable" value="DynamoDB（StateTable）&lt;br&gt;ログイン途中の状態・認可コード・&lt;br&gt;リフレッシュトークン（TTL で消える）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#C925D1;" vertex="1" parent="1">
          <mxGeometry x="890" y="250" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- 共通 -->
        <mxCell id="ssm" value="SSM パラメータストア&lt;br&gt;URL・署名鍵・セッションの秘密" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;fillColor=#E7157B;" vertex="1" parent="1">
          <mxGeometry x="1090" y="370" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- 食事記録の列 -->
        <mxCell id="mealsApi" value="API Gateway（HTTP API）&lt;br&gt;食事記録の入口（/mcp）&lt;br&gt;流量の制限：1秒1回・瞬間5回" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;fillColor=#E7157B;" vertex="1" parent="1">
          <mxGeometry x="410" y="480" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mealsFn" value="Lambda&lt;br&gt;食事記録の MCP サーバー" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;" vertex="1" parent="1">
          <mxGeometry x="650" y="480" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mealsTable" value="DynamoDB（MealsTable）&lt;br&gt;食事・いつもの・目標・体重" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#C925D1;" vertex="1" parent="1">
          <mxGeometry x="890" y="480" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- 線 -->
        <mxCell id="e1" value="ログイン・同意" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user" target="authzApi">
          <mxGeometry x="-0.3" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="OAuth&lt;br&gt;（認可・トークン）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="client" target="authzApi">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="90" y="400" />
              <mxPoint x="240" y="400" />
              <mxPoint x="240" y="295" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="MCP&lt;br&gt;（トークン付き）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="client" target="mealsApi">
          <mxGeometry x="-0.4" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="authzApi" target="authzFn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="mealsApi" target="mealsFn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="authzFn" target="stateTable">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="mealsFn" target="mealsTable">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="本人確認を任せる（OIDC）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="authzFn" target="cognito">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="680" y="140" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;dashed=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;" edge="1" parent="1" source="authzFn" target="ssm">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="770" y="295" />
              <mxPoint x="770" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;dashed=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" edge="1" parent="1" source="mealsFn" target="ssm">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="770" y="495" />
              <mxPoint x="770" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e11" value="トークン検証用の公開鍵（JWKS）を取得" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;dashed=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="mealsFn" target="authzApi">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="680" y="420" />
              <mxPoint x="440" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note" value="実線：リクエストの流れ　点線：設定や鍵の取得" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="340" y="620" width="400" height="20" as="geometry" />
